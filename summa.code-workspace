{
  "folders": [
    {
      "name": "Workspace",
      "path": "."
    },
    {
      "name": "Frontend",
      "path": "summa-frontend"
    },
    {
      "name": "Backend",
      "path": "summa-backend"
    },
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build debug API",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder:Workspace}/summa-backend/summa-backend.csproj",
          "--configuration",
          "Debug"
        ],
        "problemMatcher": "$msCompile"
      }
    ]
  },
  "settings": {
    "files.exclude": {
      // Exclude from Frontend
      ".dart_tool": true,
      "build": true,
      ".metadata": true,
      "windows": true,
      ".flutter-plugins-dependencies": true,
      "pubspec.lock": true,
      // Exclude from Backend
      "bin/": true,
      "obj/": true,
      // Exclude from Workspace
      "summa-backend": true,
      "summa-frontend": true,
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Launch Backend",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build debug API",
        "program": "${workspaceFolder:Workspace}/summa-backend/bin/Debug/net9.0/summa-backend.dll",
        "cwd": "${workspaceFolder:Workspace}/summa-backend"
      },
      {
        "name": "Launch Frontend",
        "type": "dart",
        "request": "launch",
        "cwd": "${workspaceFolder:Workspace}/summa-frontend",
        "program": "${workspaceFolder:Workspace}/summa-frontend/lib/main.dart",
        "args": [
          "-d",
          "chrome"
        ]
      }
    ],
    "compounds": [
      {
        "name": "Launch Backend + Frontend",
        "configurations": [
          "Launch Backend",
          "Launch Frontend"
        ]
      }
    ]
  }
}